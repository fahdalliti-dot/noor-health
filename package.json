{
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev & pnpm --filter api dev",
    "lint": "pnpm --filter web lint && pnpm --filter api lint",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter api typecheck",
    "test": "pnpm --filter web test && pnpm --filter api test",
    "db:migrate": "pnpm prisma migrate dev",
    "db:seed": "pnpm tsx packages/db/prisma/seed.ts",
    "build": "pnpm --filter web build && pnpm --filter api build"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.3.2"
    },
    "allowBuilds": [
      "@nestjs/core",
      "@nestjs/platform-express",
      "@nestjs/common",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "unrs-resolver",
      "workerd"
    ]
  },
  "dependencies": {
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.22",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "argon2": "^0.45.1",
    "autoprefixer": "^10.6.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "next": "^14.2.35",
    "next-intl": "^3.26.5",
    "otpauth": "^9.5.2",
    "postcss": "^8.5.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "speakeasy": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.1",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jest": "^29.7.0",
    "playwright": "^1.64.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}