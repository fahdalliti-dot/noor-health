# Environment variables for the SaaS SaaS for doctors in Morocco

# Database
DATABASE_URL="postgresql://saas_user:saas_pass@localhost:5432/saas_clinics?schema=public"

# Auth
ARGO2ID_MEMORY=67108864
ARGO2ID_PARALLELISM=4
ARGO2ID_TIMEOUT=30000
JWT_SECRET="change-this-to-a-strong-random-secret"
JWT_ACCESS_TOKEN_TTL=900   # 15 minutes in seconds
JWT_REFRESH_TOKEN_TTL=604800  # 7 days in seconds

# TOTP
TOTP_ISSUER="SaaS for Doctors"
TOTP_PERIOD=30  # seconds

# Server
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"

# Application
APP_CLINIC_ID="00000000-0000-0000-0000-000000000000"  # Set per-transaction by middleware