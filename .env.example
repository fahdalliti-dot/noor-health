# Environment variables for the SaaS for doctors in Morocco
# Copy this file to .env and fill in real values.
# NEVER commit the .env file with real passwords.

# Database (PostgreSQL 16)
# DATABASE_URL — used by Prisma Migrate with the owner role
# Format: postgresql://OWNER_USER:OWNER_PASS@localhost:5432/OWNER_DB?schema=public
DATABASE_URL="postgresql://saas_owner:saas_pass@localhost:5432/saas_dev?schema=public"
# APP_DATABASE_URL — used by the API and tests with the restricted saas_app role
APP_DATABASE_URL="postgresql://saas_app:saas_pass@localhost:5432/saas_dev?schema=public"
# TEST_DATABASE_URL — for Prisma Migrate on the test database
TEST_DATABASE_URL="postgresql://saas_owner:saas_pass@localhost:5432/saas_test?schema=public"
# TEST_APP_DATABASE_URL — restricted role on the test database
TEST_APP_DATABASE_URL="postgresql://saas_app:saas_pass@localhost:5432/saas_test?schema=public"

# Auth (Argon2id parameters — values in KiB for memory)
ARGON2ID_MEMORY=65536  # 64 MiB
ARGON2ID_PARALLELISM=4
ARGON2ID_TIMEOUT=30000
JWT_SECRET="change-this-to-a-strong-random-secret"
JWT_ACCESS_TOKEN_TTL=900   # 15 minutes in seconds
JWT_REFRESH_TOKEN_TTL=43200  # 12 hours in seconds

# TOTP
TOTP_ISSUER="SaaS for Doctors"
TOTP_PERIOD=30  # seconds

# Patient Encryption (AES-256-GCM) - generate with: openssl rand -hex 32
PATIENT_ENCRYPTION_KEY="your-32-byte-hex-key-here-64-chars"
# Blind index pepper (HMAC-SHA256) for CIN lookups - generate with: openssl rand -hex 32
BLIND_INDEX_PEPPER="your-32-byte-hex-pepper-here-64-chars"

# Server
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"
