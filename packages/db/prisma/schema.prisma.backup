generator client {
  provider = "postgresql"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

# ======================================
# ENUMS
# ======================================

enum Role {
  admin
  doctor
  secretary
}

enum Plan {
  trial
  solo
  clinic
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

enum Action {
  read
  create
  update
  delete
  export
  login
  logout
  login_failed
  2fa_setup
  2fa_disabled
  password_reset_requested
  password_reset_completed
  session_revoked
  session_reuse_detected
  invite_created
  invite_accepted
  user_deactivated
  role_changed
  clinical_access_granted
}

enum Locale {
  fr
  ar
  en
}

enum Status {
  active
  suspended
}

# ======================================
# ENTITIES
# ======================================

model Clinic {
  id             UUID                 @id @default(uuid())
  name           String
  city           String
  address        String
  phone          String
  locale         Locale               @default(fr)
  timezone       String               @default("Africa/Casablanca")
  require_2fa_all Boolean            @default(false)
  logo_key       String?
  status         Status               @default(active)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt

  users          User[]
  subscription   Subscription?       @relation(fields: [clinic_id], references: [id])

  @@index([id])
}

model User {
  id              UUID      @id @default(uuid())
  clinic_id       UUID
  email           String
  password_hash   String
  full_name       String
  role            Role
  speciality      String?
  license_number  String?
  locale          Locale?
  is_clinic_admin Boolean   @default(false)
  totp_secret     String?
  totp_enabled_at DateTime?
  is_active       Boolean   @default(true)
  last_login_at   DateTime?
  deactivated_at  DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  sessions        Session[]
  recovery_codes  RecoveryCode[]
  invites_sent    Invite[]   @relation("InvitesSent", fields: [id], references: [invited_by])
  invites_received Invite[]  @relation("InvitesReceived", fields: [invited_by], references: [id])

  @@index([clinic_id])
  @@index([email], unique: true)
}

model RecoveryCode {
  id         UUID      @id @default(uuid())
  user_id    UUID
  code_hash  String
  used_at    DateTime?
  created_at DateTime  @default(now())

  user       User      @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model Invite {
  id          UUID      @id @default(uuid())
  clinic_id   UUID
  email       String
  role        Role
  token_hash  String    @unique
  expires_at  DateTime
  accepted_at DateTime?
  revoked_at  DateTime?
  invited_by  UUID

  @@index([clinic_id, email], unique: true)
  @@index([token_hash], unique: true)
}

model Session {
  id                UUID      @id @default(uuid())
  user_id           UUID
  clinic_id         UUID
  family_id         UUID      @default(uuid())
  refresh_token_hash String   @unique
  device_label      String?
  ip                String?
  created_at        DateTime  @default(now())
  last_used_at      DateTime  @default(now())
  expires_at        DateTime
  revoked_at        DateTime?
  revoked_reason    String?

  user     User     @relation(fields: [user_id], references: [id])
  clinic   Clinic  @relation(fields: [clinic_id], references: [id])

  @@index([user_id, family_id])
  @@index([refresh_token_hash], unique: true)
}

model Subscription {
  id            UUID               @id @default(uuid())
  clinic_id     UUID               @unique
  plan          Plan               @default(trial)
  status        SubscriptionStatus @default(trialing)
  trial_ends_at DateTime
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt

  clinic        Clinic             @relation(fields: [clinic_id], references: [id])
}

model AuditLog {
  id          UUID     @id @default(uuid())
  clinic_id   UUID?
  user_id     UUID?
  action      Action
  entity_type String?
  entity_id   UUID?
  request_id  String
  ip          String?
  user_agent  String?
  metadata    Json
  occurred_at DateTime @default(now())

  @@index([clinic_id, occurred_at, sort: desc])
  @@index([clinic_id, entity_type, entity_id])
}