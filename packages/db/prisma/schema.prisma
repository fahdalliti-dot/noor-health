// ======================================
// SCHEMA - Slice 1 Tables
// ======================================

// Datasource configuration
// The connection URL is read from process.env.DATABASE_URL via prisma.config.ts
datasource db {
  provider = "postgresql"
}

// ENUMS

enum Role {
  admin
  doctor
  secretary
}

enum Plan {
  trial
  solo
  clinic
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

enum Action {
  read
  create
  update
  delete
  export
  login
  logout
  login_failed
  permission_denied
  two_fa_setup
  two_fa_disabled
  password_reset_requested
  password_reset_completed
  session_revoked
  session_reuse_detected
  invite_created
  invite_accepted
  user_deactivated
  role_changed
  clinical_access_granted
}

enum Locale {
  fr
  ar
  en
}

enum Status {
  active
  suspended
}

enum AppointmentStatus {
  scheduled
  confirmed
  arrived
  in_progress
  completed
  cancelled
  no_show
}

enum AppointmentSource {
  staff
  online
}

enum Gender {
  male
  female
  other
  unknown
}

enum BloodType {
  A_positive
  A_negative
  B_positive
  B_negative
  AB_positive
  AB_negative
  O_positive
  O_negative
  unknown
}

enum CertificateType {
  aptitude
  arret_travail
  coups_et_blessures
  prolonge_arret
}

enum PaymentMethod {
  cash
  cmi_card
  virement
  cheque
}

enum PaymentStatus {
  completed
  pending
  failed
  refunded
}

enum InventoryCategory {
  consumable
  medication
  equipment
  office
}

enum InventoryAction {
  restock
  usage
  waste
  adjustment
}

enum NotificationChannel {
  whatsapp
  sms
}

enum NotificationStatus {
  queued
  sent
  delivered
  read
  failed
}

// ENTITIES

model Clinic {
  id                String   @id @default(uuid())
  name              String
  city              String
  address           String
  phone             String
  locale            Locale   @default(fr)
  timezone          String   @default("Africa/Casablanca")
  require_2fa_all   Boolean  @default(false)
  first_day_of_week Int      @default(0) // 0=Monday (decision 8)
  logo_key          String?
  status            Status   @default(active)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  users                 User[]
  sessions              Session[]
  password_reset_tokens PasswordResetToken[]
  subscription          Subscription?

  // Slice 3 - reverse relations
  appointments  Appointment[]
  working_hours DoctorWorkingHours[]
  time_off      DoctorTimeOff[]

  // Slice 2 - reverse relations
  patients      Patient[]

  // Clinical & Practice Management expansions
  prescriptions         Prescription[]
  medical_certificates  MedicalCertificate[]
  payments              PaymentTransaction[]
  inventory_items       InventoryItem[]
  notifications         NotificationLog[]

  @@index([id])
}

model User {
  id              String    @id @default(uuid())
  clinic_id       String
  clinic          Clinic    @relation(fields: [clinic_id], references: [id])
  email           String    @unique
  password_hash   String
  full_name       String
  role            Role
  speciality      String?
  license_number  String?
  locale          Locale?
  is_clinic_admin Boolean   @default(false)
  totp_secret     String?
  totp_enabled_at DateTime?
  is_active       Boolean   @default(true)
  last_login_at   DateTime?
  deactivated_at  DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  sessions              Session[]
  recovery_codes        RecoveryCode[]
  password_reset_tokens PasswordResetToken[]
  invites_sent          Invite[]             @relation("InvitesSent")

  // Slice 3 - reverse relations
  appointments_as_doctor  Appointment[]        @relation("AppointmentDoctor")
  appointments_as_creator Appointment[]        @relation("AppointmentCreator")
  working_hours           DoctorWorkingHours[]
  time_off                DoctorTimeOff[]

  // Clinical & Practice Management expansions
  prescriptions_as_doctor Prescription[]        @relation("PrescriptionDoctor")
  certificates_as_doctor  MedicalCertificate[]  @relation("CertificateDoctor")
  payments_recorded       PaymentTransaction[]  @relation("PaymentRecordedBy")
  inventory_logs          InventoryLog[]        @relation("InventoryActor")
}

model RecoveryCode {
  id         String    @id @default(uuid())
  user_id    String
  code_hash  String
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id])
}

model Invite {
  id          String    @id @default(uuid())
  clinic_id   String
  email       String
  role        Role
  token_hash  String    @unique
  expires_at  DateTime
  accepted_at DateTime?
  revoked_at  DateTime?
  invited_by  String

  sent_by User @relation("InvitesSent", fields: [invited_by], references: [id])

  @@index([token_hash])
}

model Session {
  id                 String    @id @default(uuid())
  user_id            String
  clinic_id          String
  family_id          String    @default(uuid())
  refresh_token_hash String    @unique
  device_label       String?
  ip                 String?
  created_at         DateTime  @default(now())
  last_used_at       DateTime  @default(now())
  expires_at         DateTime
  revoked_at         DateTime?
  revoked_reason     String?

  user   User   @relation(fields: [user_id], references: [id])
  clinic Clinic @relation(fields: [clinic_id], references: [id])
}

model Subscription {
  id            String             @id @default(uuid())
  clinic_id     String             @unique
  clinic        Clinic             @relation(fields: [clinic_id], references: [id])
  plan          Plan               @default(trial)
  status        SubscriptionStatus @default(trialing)
  trial_ends_at DateTime
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  clinic_id  String
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?

  clinic Clinic @relation(fields: [clinic_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])

  @@index([clinic_id, user_id])
}

model AuditLog {
  id          String    @id @default(uuid())
  clinic_id   String?
  user_id     String?
  action      Action
  entity_type String?
  entity_id   String?
  request_id  String
  ip          String?
  user_agent  String?
  metadata    Json
  occurred_at DateTime  @default(now())
  token_hash  String?
  used_at     DateTime?
  expires_at  DateTime?

  @@index([clinic_id, occurred_at])
  @@index([clinic_id, entity_type, entity_id])
}

// ======================================
// SLICE 3 - Appointments & Agenda
// ======================================

model Appointment {
  id            String            @id @default(uuid())
  clinic_id     String
  patient_id    String // non-nullable FK to Patient (Slice 2 follow-up migration)
  doctor_id     String
  starts_at     DateTime
  ends_at       DateTime
  status        AppointmentStatus @default(scheduled)
  reason        String?
  source        AppointmentSource @default(staff)
  cancelled_at  DateTime?
  cancel_reason String?
  created_by    String
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  clinic          Clinic   @relation(fields: [clinic_id], references: [id])
  patient         Patient? @relation(fields: [patient_id], references: [id])
  doctor          User     @relation("AppointmentDoctor", fields: [doctor_id], references: [id])
  created_by_user User     @relation("AppointmentCreator", fields: [created_by], references: [id])
  notifications   NotificationLog[]

  // Adjacent appointments (end = next start) are allowed because [) is half-open.
  // Only active statuses participate in the double-booking exclusion constraint.
  @@index([clinic_id, doctor_id, starts_at])
  @@index([clinic_id, starts_at])
  @@index([clinic_id, status])
}

model DoctorWorkingHours {
  id                  String   @id @default(uuid())
  clinic_id           String
  doctor_id           String
  weekday             Int // 0=Monday .. 6=Sunday (decision 8)
  start_minutes       Int // minutes from midnight in clinic timezone
  end_minutes         Int
  slot_length_minutes Int      @default(30)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  clinic Clinic @relation(fields: [clinic_id], references: [id])
  doctor User   @relation(fields: [doctor_id], references: [id])

  @@unique([clinic_id, doctor_id, weekday, start_minutes])
  @@index([clinic_id, doctor_id])
}

model DoctorTimeOff {
  id         String   @id @default(uuid())
  clinic_id  String
  doctor_id  String
  start_at   DateTime
  end_at     DateTime
  reason     String?
  created_at DateTime @default(now())

  clinic Clinic @relation(fields: [clinic_id], references: [id])
  doctor User   @relation(fields: [doctor_id], references: [id])

  @@index([clinic_id, doctor_id, start_at, end_at])
}

// ======================================
// SLICE 2 - Patient Records
// ======================================

model Patient {
  id                    String   @id @default(uuid())
  clinic_id             String
  file_number           Int      @default(0) // per-clinic sequence (composite unique with clinic_id)
  first_name            String
  last_name             String
  birth_date            DateTime // stored as date (UTC midnight)
  gender                Gender
  phone                 String?
  email                 String?
  address               String?
  emergency_contact_name String?
  emergency_contact_phone String?
  cin                   String?  // encrypted AES-256-GCM (Moroccan CIN/JINC)
  cin_hash              String?  // HMAC-SHA256 blind index (peppered) for duplicate lookup
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  deleted_at            DateTime? // soft delete (CLAUDE.md rule #7)

  clinic          Clinic               @relation(fields: [clinic_id], references: [id])
  medical_profile PatientMedicalProfile?
  appointments    Appointment[]

  // Clinical & Practice Management expansions
  prescriptions   Prescription[]
  certificates    MedicalCertificate[]
  payments        PaymentTransaction[]
  notifications   NotificationLog[]

  @@unique([clinic_id, file_number])
  @@index([clinic_id, first_name, last_name])
  @@index([clinic_id, deleted_at])
}

model PatientMedicalProfile {
  id                   String   @id @default(uuid())
  patient_id           String   @unique
  height_cm            Int?     // cm
  weight_kg            Float?   // kg
  blood_type           BloodType?
  allergies            Json?    // string[]
  chronic_conditions   Json?    // string[]
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  deleted_at           DateTime? // soft delete

  patient Patient @relation(fields: [patient_id], references: [id])
}

// ======================================
// CLINICAL & PRACTICE MANAGEMENT EXPANSION
// ======================================

model Prescription {
  id                String             @id @default(uuid())
  clinic_id         String
  patient_id        String
  doctor_id         String
  appointment_id    String?
  prescription_date DateTime           @default(now())
  diagnosis         String?
  notes             String?
  qr_code_token     String             @default(uuid())
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  clinic            Clinic             @relation(fields: [clinic_id], references: [id])
  patient           Patient            @relation(fields: [patient_id], references: [id])
  doctor            User               @relation("PrescriptionDoctor", fields: [doctor_id], references: [id])
  items             PrescriptionItem[]

  @@index([clinic_id, patient_id])
  @@index([clinic_id, doctor_id])
}

model PrescriptionItem {
  id              String        @id @default(uuid())
  prescription_id String
  medication_name String
  dosage          String
  form            String        // Comprimé, Sirop, Sachet, Gélule, Solution injectable
  frequency       String        // 1x/jour, 3x/jour, matin et soir, si besoin
  duration        String        // 7 jours, 1 mois, 3 mois
  instructions    String?       // Pendant le repas, à jeun, etc.
  created_at      DateTime      @default(now())

  prescription    Prescription  @relation(fields: [prescription_id], references: [id], onDelete: Cascade)

  @@index([prescription_id])
}

model MedicalCertificate {
  id              String          @id @default(uuid())
  clinic_id       String
  patient_id      String
  doctor_id       String
  type            CertificateType @default(aptitude)
  title           String
  content         String
  start_date      DateTime        @default(now())
  end_date        DateTime?
  itt_days        Int?            // Incapacité Totale de Travail (days)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  clinic          Clinic          @relation(fields: [clinic_id], references: [id])
  patient         Patient         @relation(fields: [patient_id], references: [id])
  doctor          User            @relation("CertificateDoctor", fields: [doctor_id], references: [id])

  @@index([clinic_id, patient_id])
  @@index([clinic_id, doctor_id])
}

model PaymentTransaction {
  id                 String         @id @default(uuid())
  clinic_id          String
  patient_id         String?
  appointment_id     String?
  amount             Decimal        @db.Decimal(10, 2)
  currency           String         @default("MAD")
  method             PaymentMethod  @default(cash)
  status             PaymentStatus  @default(completed)
  receipt_number     String         @unique
  cmi_transaction_id String?
  notes              String?
  created_by         String
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  clinic             Clinic         @relation(fields: [clinic_id], references: [id])
  patient            Patient?       @relation(fields: [patient_id], references: [id])
  recorded_by        User           @relation("PaymentRecordedBy", fields: [created_by], references: [id])

  @@index([clinic_id, created_at])
  @@index([clinic_id, method])
}

model InventoryItem {
  id            String             @id @default(uuid())
  clinic_id     String
  name          String
  category      InventoryCategory  @default(consumable)
  sku           String?
  quantity      Int                @default(0)
  min_threshold Int                @default(5)
  unit          String             @default("unité") // boîte, flacon, seringue
  unit_cost     Decimal?           @db.Decimal(10, 2)
  supplier      String?
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt

  clinic        Clinic             @relation(fields: [clinic_id], references: [id])
  logs          InventoryLog[]

  @@index([clinic_id, category])
  @@index([clinic_id, name])
}

model InventoryLog {
  id          String          @id @default(uuid())
  item_id     String
  action      InventoryAction
  quantity    Int             // positive for restock, negative for usage
  reason      String?
  actor_id    String
  created_at  DateTime        @default(now())

  item        InventoryItem   @relation(fields: [item_id], references: [id], onDelete: Cascade)
  actor       User            @relation("InventoryActor", fields: [actor_id], references: [id])

  @@index([item_id])
}

model NotificationLog {
  id                  String              @id @default(uuid())
  clinic_id           String
  appointment_id      String?
  patient_id          String?
  channel             NotificationChannel @default(whatsapp)
  recipient_phone     String
  template_name       String
  language            String              @default("ar_MA")
  status              NotificationStatus  @default(queued)
  provider_message_id String?
  content_preview     String
  error_message       String?
  sent_at             DateTime?
  delivered_at        DateTime?
  created_at          DateTime            @default(now())

  clinic              Clinic              @relation(fields: [clinic_id], references: [id])
  appointment         Appointment?        @relation(fields: [appointment_id], references: [id])
  patient             Patient?            @relation(fields: [patient_id], references: [id])

  @@index([clinic_id, created_at])
  @@index([appointment_id])
  @@index([provider_message_id])
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  previewFeatures = []
}
